{
  "name": "t-astro-web-studio",
  "private": true,
  "version": "1.0.0",
  "description": "T-Astro Web Studio desktop astronomy application",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=server.cjs --external:vite --external:lightningcss --external:esbuild",
    "build": "npm run build:web && npm run build:server",
    "start": "NODE_ENV=production node server.cjs",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win portable",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@types/xmlrpc": "^1.3.10",
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "ws": "^8.19.0",
    "xmlrpc": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.tstudio.tastrowebstudio",
    "productName": "T-Astro Web Studio",
    "asar": true,
    "files": ["main.cjs", "server.cjs", "dist/**/*", "package.json"],
    "extraResources": [{"from": "solver_server.py", "to": "solver/solver_server.py"}],
    "directories": {"output": "release"},
    "win": {"target": ["nsis"], "artifactName": "T-Astro-Web-Studio-${version}-Setup.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}
